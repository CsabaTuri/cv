# =============================================================================
# CV + custom chat stack - environment template
#
#   cp .env.example .env && $EDITOR .env
#
# `docker compose` refuses to start when a value marked <required> is missing or
# empty (${VAR:?}), so the stack can neither run with a blank password nor
# without a concrete image version.
# Never commit the real .env (it is git-ignored); keep it `chmod 600`.
# =============================================================================

# --- required ----------------------------------------------------------------

# Database name and application credentials (<required>).
# Generate the passwords with: openssl rand -hex 32
MYSQL_DATABASE=cv_chat
MYSQL_USER=chat
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# One tag per image (<required>, never `latest`). A concrete version per image is
# what makes a rollback possible, and the compose files refuse to start when any
# of them is missing. Defaults below match the versions in the package.json
# files; change them the way you version the two applications.
#   release:  bump the value(s), then
#     docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#   rollback: put the previous version back, then `up -d` WITHOUT --build
#     (the previous image stays on the host - do not prune it away)
# The rebuild helper passes these values on to the build it triggers, so it only
# sees a new value once it has been recreated by that same command.
# A concrete version per image - never `latest`. The CI publishes the same
# images to ghcr.io tagged with the commit (`sha-1a2b3c4`), so a value from
# either kind works here; `docker compose pull` needs it to be a published one.
IMAGE_TAG_CV=1.0.0
IMAGE_TAG_CHAT_BACKEND=2.0.0
IMAGE_TAG_DEPLOYER=1.0.0

# Admin panel / admin API token (<required>).
# Log in with it at /admin/ and read it with: grep ADMIN_TOKEN .env
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- optional ----------------------------------------------------------------

# Time zone for MySQL and phpMyAdmin.
TZ=Europe/Budapest

# Host interfaces the published ports are bound to.
#   dev (docker-compose.override.yml) defaults to 0.0.0.0 for the API and
#   phpMyAdmin; the production overlay pins both to 127.0.0.1 regardless.
SITE_BIND=0.0.0.0
API_BIND=127.0.0.1
PHPMYADMIN_BIND=127.0.0.1

# --- Web Push (push notifications) -------------------------------------------

# VAPID key pair for the notifications that arrive with the browser closed.
# Rotating it invalidates every existing subscription: each browser has to turn
# notifications on again. Generate a pair with:
#   docker run --rm --entrypoint node cv-chat-backend:2.0.0 \
#     -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave them empty to run without push (the API then answers 503).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact the push services use in case of abuse: a mailto: or an https: URL.
VAPID_SUBJECT=https://turicsaba.hu

# --- one-click rebuild (optional) --------------------------------------------

# Enables the admin panel's rebuild button. The `deployer` helper is part of the
# stack (it holds the Docker socket, which is root-equivalent on the host), so
# this switch is what keeps it inert: with `false` it still reports status, but
# refuses to build anything.
DEPLOY_ENABLED=false

# Compose files the triggered rebuild uses, colon separated (same syntax as
# COMPOSE_FILE). The development stack needs the override file here:
#   DEPLOY_COMPOSE_FILES=docker-compose.yml:docker-compose.override.yml
DEPLOY_COMPOSE_FILES=docker-compose.yml:docker-compose.prod.yml

# Services the button rebuilds and restarts.
DEPLOY_SERVICES=cv chat-backend

# Where the source tree lives for the helper. Defaults to the stack directory.
# DEPLOY_SOURCE_DIR=/home/csaba/Documents/work/cv/cv

# Cloudflare Web Analytics token, baked into the static build (optional).
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
