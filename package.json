{
  "name": "cv-stack",
  "version": "1.0.0",
  "private": true,
  "description": "Repository-wide tooling for the CV site, its chat backend and the deployer.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:test:start": "bash tests/test-db.sh start",
    "db:test:stop": "bash tests/test-db.sh stop",
    "test": "node --test tests/*.test.mjs",
    "test:junit": "mkdir -p test-results && node --test --test-reporter=junit --test-reporter-destination=test-results/junit.xml tests/*.test.mjs",
    "test:report": "node .github/scripts/test-summary.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "allure:unit": "node tests/allure-from-junit.mjs test-results/junit.xml --out allure-results --parent \"Unit tests\"",
    "allure:generate": "allure generate allure-results --clean --output allure-report",
    "allure:open": "allure open allure-report",
    "allure:local": "npm run e2e && npm run test:junit && npm run allure:unit && npm run allure:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.0",
    "@playwright/test": "^1.63.0",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
